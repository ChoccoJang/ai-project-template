{
  "version": 2,
  "_안내": "생성물이다 — themes.json을 고치고 scripts/build_tokens.py로 다시 만든다.",
  "format": "#RRGGBB (sRGB, opaque)",
  "default": {"light": "zen-light", "dark": "zen-dark", "rule": "저장값이 없거나 모르는 id면 OS 모드에 따라 light/dark 기본 테마"},
  "derivation": {
    "mix(a, b, t)": "채널별 a + (b - a) * t, 반올림",
    "up": "dark 테마 #FFFFFF, light 테마 #000000",
    "x/y": "dark 테마 값 / light 테마 값",
    "contrast(a, b)": "WCAG 2.x 대비 (Lmax + 0.05) / (Lmin + 0.05), L은 선형화한 상대 휘도",
    "text-surfaces": "bg · sidebar-bg · panel · code-bg — 글자가 놓이는 바탕",
    "readable(c, n)": "mix(c, fg, t)에서 text-surfaces 모두와 contrast >= n이 되는 가장 작은 t (0.01 단위). n을 생략하면 4.5",
    "group": "hue = ANSI 초록·자홍·노랑·파랑·빨강·청록 (dark 10,13,11,12,9,14 / light 2,5,3,4,1,6), accent와 가장 가까운 hue를 맨 뒤로. bg = mix(bg, hue, 0.11), border = mix(bg, hue, 0.45)"
  },
  "tokens": {
    "bg": {"use": "앱·본문·편집 영역 바탕", "rule": "base.bg"},
    "fg": {"use": "본문 글자", "rule": "base.fg"},
    "accent": {"use": "강조·링크·포커스 링", "rule": "base.accent"},
    "selection": {"use": "텍스트 선택 영역", "rule": "base.selection"},
    "text-strong": {"use": "제목·활성 라벨", "rule": "fg"},
    "text-muted": {"use": "보조 글자·placeholder·비활성", "rule": "readable(ansi8)"},
    "on-accent": {"use": "accent 바탕 위 글자", "rule": "#141416·#FFFFFF 중 accent와 contrast가 큰 쪽"},
    "border": {"use": "구분선·표 선 (장식용)", "rule": "mix(bg, fg, 0.18)"},
    "control-border": {"use": "입력칸·체크박스·토글처럼 경계가 있어야 알아보는 컨트롤 테두리", "rule": "border를 fg 쪽으로 옮겨 bg·sidebar-bg·panel과 contrast >= 3"},
    "sidebar-bg": {"use": "사이드바·트리 바탕", "rule": "mix(bg, up, 0.03/0.02)"},
    "panel": {"use": "타이틀바·툴바·상태바·탭 줄·하단 탭바·시트·모달·팝오버 바탕", "rule": "mix(bg, up, 0.05/0.04)"},
    "pressed": {"use": "눌린 버튼·터치 중인 항목", "rule": "mix(bg, up, 0.09/0.07)"},
    "raised": {"use": "활성 탭·호버한 버튼", "rule": "mix(bg, up, 0.14/0.10)"},
    "row-hover": {"use": "행 호버", "rule": "mix(bg, fg, 0.07)"},
    "row-selected": {"use": "행 선택", "rule": "mix(bg, accent, 0.20)"},
    "tree-guide": {"use": "들여쓰기 가이드선", "rule": "mix(bg, fg, 0.13)"},
    "highlight": {
      "use": "검색 일치 바탕",
      "rule": "mix(bg, ansi11/ansi3, t), t는 0.36/0.30에서 contrast(fg, 결과) >= 4.5가 될 때까지 0.01씩 줄인다"
    },
    "danger": {"use": "오류·삭제 글자와 아이콘, 오류 입력칸 테두리", "rule": "readable(ansi9/ansi1)"},
    "success": {"use": "성공·완료 글자와 아이콘", "rule": "readable(ansi10/ansi2)"},
    "warning": {"use": "경고 글자와 아이콘", "rule": "readable(ansi11/ansi3)"},
    "danger-hover": {"use": "창 닫기 버튼 호버 — Windows 전용, 테마 무관 고정", "rule": "#C42B1C"},
    "on-danger": {"use": "danger-hover 위 글자 (고정)", "rule": "#FFFFFF"},
    "code-bg": {"use": "코드 블록 바탕", "rule": "mix(bg, fg, 0.06)"},
    "code-action-bg": {"use": "코드 블록 위 버튼(복사 등)", "rule": "mix(bg, up, 0.10/0.08)"},
    "code-inline": {"use": "인라인 코드 글자", "rule": "readable(ansi13/ansi5)"},
    "syntax-comment": {"use": "주석", "rule": "text-muted"},
    "syntax-string": {"use": "문자열", "rule": "readable(ansi10/ansi2)"},
    "syntax-number": {"use": "숫자", "rule": "readable(ansi14/ansi6)"},
    "syntax-keyword": {"use": "키워드", "rule": "readable(ansi12/ansi4)"},
    "diagram-node-bg": {"use": "노드 바탕", "rule": "mix(bg, accent, 0.16)"},
    "diagram-node-border": {"use": "노드 테두리", "rule": "mix(bg, accent, 0.45)"},
    "diagram-line": {"use": "연결선·화살표", "rule": "text-muted"}
  },
